PORT=3000
DATABASE_URL=postgres://opshub:change-me@localhost:5432/opshub
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
AUTH_COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: create the first global administrator when running the seed script.
SEED_ADMIN_NAME=OpsHub Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters

# Required for creating accounts through the user management endpoints.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
