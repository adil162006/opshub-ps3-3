PORT=3000
DATABASE_URL=postgres://opshub:change-me@localhost:5432/opshub
# Set JWT_SECRET to a cryptographically random value of at least 32 bytes.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
AUTH_COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: create the first global administrator when running the seed script.
SEED_ADMIN_NAME=OpsHub Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters

# Required for sending account invitations through the user management endpoints.
# SMTP_FROM_EMAIL must be an address accepted by your provider; SMTP_USERNAME may also be used as the sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
